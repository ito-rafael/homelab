# URL clients will connect to
server_url: https://andira.lbic.fee.unicamp.br
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090
# enable CLI communication
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

# Caddy handles Let's Encrypt --> no need for TLS configuration anymore
## Let's Encrypt automatic HTTPS (requires TCP 80 and 443)
#tls_letsencrypt_hostname: "andira.lbic.fee.unicamp.br"
#tls_letsencrypt_listen: "0.0.0.0:8080"
#tls_letsencrypt_cache_dir: "/var/lib/headscale/cache"
#tls_letsencrypt_challenge_type: HTTP-01

# IP ranges for Tailscale clients
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48

# DNS
dns:
  magic_dns: true
  base_domain: lbic.internal
  nameservers:
    global:
      - 1.1.1.1
      - 8.8.8.8
  override_local_dns: true

private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

# add Tailscale's default public DERP servers
derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

oidc:
  # require OIDC to be functional for Headscale to start
  only_start_if_oidc_is_available: true

  # Kanidm issues tokens at this specific path:
  issuer: "https://andira.lbic.fee.unicamp.br/oauth2/openid/headscale"

  client_id: "headscale"
  client_secret: "{{ headscale_oidc_secret_raw.stdout | trim }}"

  # enable PKCE for enhanced OAuth2 security
  pkce:
    enabled: true
    method: S256

  # request the scopes
  scope: ["openid", "profile", "email"]
