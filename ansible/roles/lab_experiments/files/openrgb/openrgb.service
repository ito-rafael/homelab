[Service]
Type=simple
User=lbic-user
Group=lbic-user
Environment=HOME=/home/lbic-user
Environment=LIBGL_ALWAYS_SOFTWARE=1
WorkingDirectory=/home/lbic-user

ExecStart=/usr/bin/xvfb-run -a \
    -s "-screen 0 1024x768x24 +extension GLX +render -noreset" \
    /usr/bin/openrgb \
        --gui \
        --server \
        --noautoconnect \
        --profile /home/lbic-user/.config/OpenRGB/profile.orp \
        --loglevel 6 \
        --verbose

Restart=on-failure
RestartSec=5
