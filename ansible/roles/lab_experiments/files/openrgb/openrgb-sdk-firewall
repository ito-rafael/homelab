#!/bin/sh
set -eu

IPTABLES=/usr/sbin/iptables
LBIC_UID=$(/usr/bin/id -u lbic-user)

# reject connections to the local OpenRGB SDK port from every other UID.
# "-C" makes this safe to run repeatedly without duplicating the rule.
if ! "$IPTABLES" -C OUTPUT \
    -o lo \
    -d 127.0.0.1/32 \
    -p tcp --dport 6742 \
    -m owner ! --uid-owner "$LBIC_UID" \
    -j REJECT --reject-with tcp-reset 2>/dev/null; then

    "$IPTABLES" -I OUTPUT 1 \
        -o lo \
        -d 127.0.0.1/32 \
        -p tcp --dport 6742 \
        -m owner ! --uid-owner "$LBIC_UID" \
        -j REJECT --reject-with tcp-reset
fi
